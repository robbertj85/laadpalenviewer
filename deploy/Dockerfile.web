# Next.js app (UI + /api/geocode + /api/usage) as a standalone Node server.
# Static data is NOT baked in: nginx (deploy/nginx.conf) serves it from the data volume.
FROM node:22-bookworm-slim AS build
WORKDIR /app/webapp
COPY webapp/package.json webapp/package-lock.json ./
RUN npm ci
COPY webapp/ ./
ARG NEXT_PUBLIC_BASE_PATH=/laadpalenviewer
ARG NEXT_PUBLIC_UMAMI_SRC=
ARG NEXT_PUBLIC_UMAMI_WEBSITE_ID=
ENV NEXT_PUBLIC_BASE_PATH=$NEXT_PUBLIC_BASE_PATH \
    NEXT_PUBLIC_UMAMI_SRC=$NEXT_PUBLIC_UMAMI_SRC \
    NEXT_PUBLIC_UMAMI_WEBSITE_ID=$NEXT_PUBLIC_UMAMI_WEBSITE_ID \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-bookworm-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0 \
    LPV_HISTORY_DB=/srv/lpv/state/history.db
COPY --from=build --chown=node:node /app/webapp/.next/standalone ./
COPY --from=build --chown=node:node /app/webapp/.next/static ./.next/static
# public/ holds only build-time assets (the MapLibre worker); data comes from nginx.
COPY --from=build --chown=node:node /app/webapp/public ./public
RUN mkdir -p /srv/lpv/state && chown node:node /srv/lpv/state
USER node
EXPOSE 3000
CMD ["node", "server.js"]
